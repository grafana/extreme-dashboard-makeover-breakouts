      "panel-11": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "loki-nginx"
                      },
                      "group": "loki",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum by (geoip_country_code) (count_over_time({filename=~`.*json_access.log.*`} | json | geoip_country_code != \"\" | __error__=\"\" [$__interval]))",
                        "legendFormat": "{{geoip_country_code}}",
                        "queryType": "instant"
                      },
                      "version": "v0"
                    },
                    "refId": "Hits by Geolocation"
                  }
                }
              ],
              "queryOptions": {
                "maxDataPoints": 1
              },
              "transformations": []
            }
          },
          "description": "Geographic distribution of inbound HTTP requests derived from nginx access logs enriched with GeoIP. Larger stars indicate higher hit counts from that country. Useful for understanding traffic patterns, planning capacity by region, and spotting unexpected spikes from unusual geographies.",
          "id": 11,
          "links": [],
          "title": "Request Volume - Geographic Distribution by Country",
          "transparent": true,
          "vizConfig": {
            "group": "geomap",
